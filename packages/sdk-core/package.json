{
  "name": "@usergist/sdk-core",
  "version": "0.1.0",
  "description": "Shared types and utilities across the userGist feedback platform",
  "license": "MIT",
  "homepage": "https://usergist.com/docs/sdks/core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Future-Picnic/usergist-js.git",
    "directory": "packages/sdk-core"
  },
  "bugs": {
    "url": "https://github.com/Future-Picnic/usergist-js/issues"
  },
  "keywords": [
    "usergist",
    "mobile-sdk",
    "targeting",
    "surveys"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./mobile": {
      "types": "./dist/mobile.d.ts",
      "import": "./dist/mobile.js",
      "require": "./dist/mobile.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": ["dist", "mobile.js", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  }
}
