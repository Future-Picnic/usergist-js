{
  "name": "@ritmus/feedback-react-native",
  "version": "0.1.0",
  "description": "Ritmus feedback + push SDK for React Native (self-contained, no Firebase/OneSignal/WonderPush required)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview/index.d.ts",
      "import": "./dist/preview/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "ios",
    "android",
    "RitmusFeedback.podspec",
    "react-native.config.js",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.19",
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-safe-area-context": ">=4"
  },
  "dependencies": {
    "@ritmus/sdk-core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "react": "^18.3.1",
    "react-native": "0.74.0",
    "react-native-safe-area-context": "^4",
    "typescript": "^5.5.4"
  },
  "codegenConfig": {
    "name": "RNRitmusPushSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "studio.ritmus.feedback"
    }
  }
}
