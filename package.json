{
  "name": "usergist-feedback",
  "version": "0.1.0",
  "private": true,
  "description": "userGist mobile engagement tool — feedback pillar v1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:terminals": "./scripts/run-dev-terminals.sh",
    "dev:api": "pnpm --filter @usergist/api dev",
    "dev:admin": "NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:18673/callback node --env-file=.env ./scripts/run-admin-dev.mjs",
    "dev:dashboard": "pnpm --filter @usergist/dashboard dev",
    "dev:landing": "pnpm --filter @usergist/landing dev",
    "choro:server": "pnpm --filter @usergist/api dev",
    "choro:admin": "NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:18673/callback node --env-file=.env ./scripts/run-admin-dev.mjs",
    "choro:web": "pnpm --filter @usergist/dashboard dev",
    "choro:metro": "pnpm --filter @usergist/demo-react-native metro",
    "choro:app:ios": "pnpm --filter @usergist/demo-react-native ios",
    "choro:app:android": "pnpm --filter @usergist/demo-react-native android",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --if-present test",
    "check:services": "pnpm --filter @usergist/api check:services",
    "smoke:launch": "pnpm --filter @usergist/api smoke:launch",
    "load:launch": "pnpm --filter @usergist/api load:launch",
    "acceptance:non-push": "pnpm --filter @usergist/api acceptance:non-push",
    "fixtures:non-push": "pnpm --filter @usergist/api fixtures:non-push",
    "reset:demo-results": "pnpm --filter @usergist/api reset:demo-results",
    "verify:non-push": "pnpm test && pnpm acceptance:non-push",
    "verify:non-push:ios": "pnpm verify:non-push && pnpm --filter @usergist/demo-react-native qa:non-push:ios",
    "verify:feedback:ios": "pnpm --filter @usergist/demo-react-native qa:feedback:ios",
    "verify:survey:ios": "pnpm --filter @usergist/demo-react-native qa:survey:ios",
    "verify:inapp:ios": "pnpm --filter @usergist/demo-react-native qa:inapp:ios",
    "verify:request:ios": "pnpm --filter @usergist/demo-react-native qa:request:ios",
    "verify:push:ios": "pnpm --filter @usergist/demo-react-native qa:push:ios",
    "verify:survey-inapp:ios": "pnpm --filter @usergist/demo-react-native qa:survey-inapp:ios",
    "verify:qa:code": "pnpm --filter @usergist/api typecheck && pnpm --filter @usergist/feedback-react-native typecheck && pnpm --filter @usergist/demo-react-native typecheck && pnpm --filter @usergist/api test && pnpm --filter @usergist/feedback-react-native test && pnpm acceptance:non-push",
    "verify:qa:ui": "pnpm --filter @usergist/demo-react-native qa:non-push:ios && pnpm verify:feedback:ios && pnpm verify:survey:ios && pnpm verify:inapp:ios && pnpm verify:request:ios && pnpm verify:push:ios",
    "verify:qa:ios": "pnpm check:services && pnpm verify:qa:code && pnpm verify:qa:ui",
    "db:migrate": "pnpm --filter @usergist/api db:migrate",
    "db:seed": "pnpm --filter @usergist/api db:seed",
    "parity": "tsx tools/check-parity.ts && tsx tools/check-demo-parity.ts",
    "parity:demos": "tsx tools/check-demo-parity.ts"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
